# Docker Compose local
DB_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=troque-por-uma-chave-base64-de-pelo-menos-32-bytes
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SWAGGER_ENABLED=true

# Ambiente publicado (perfil prod). No Compose o banco vem do proprio servico
# postgres; ao publicar, DB_URL aponta para o PostgreSQL externo.
# Exemplo com Neon: jdbc:postgresql://ep-xxx.sa-east-1.aws.neon.tech/agendapro?sslmode=require
# DB_URL=
# DB_USERNAME=
# PORT=8080
# Inclua classpath:db/devdata para publicar com os dados de demonstracao.
# FLYWAY_LOCATIONS=classpath:db/migration
